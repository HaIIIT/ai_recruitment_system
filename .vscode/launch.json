{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome localhost",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open index.html",
            "type": "pwa-chrome",
            "request": "launch",
            "file": "${workspaceFolder}/html/index.html"
        }
    ]
}